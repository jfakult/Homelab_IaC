pki-out/
*.conf.butlah*
# Real env files hold secrets and are never tracked. Their templates (*.env.j2,
# *.conf.j2, snippets/*.j2) ARE tracked: they must only reference vault variables.
.env
*.env
# Contains a literal Jellyfin API key. Move it to the vault (JELLYFIN_API_KEY={{ vault_... }}),
# then delete this line and track the file.
ansible/roles/media/templates/jellyfin_exporter.env.j2

# === Terraform ===
# Local .terraform directories
.terraform/
.terraform.lock.hcl

# Terraform state
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Override files (local only)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Sensitive variable files
terraform.tfvars
*.auto.tfvars

# === Ansible ===
# Vault secrets
*.vault.yml
*.vault.json
vault_pass.txt
hosts.ini

# Retry files (generated on failed runs)
*.retry

# === General ===
# OS / Editor junk
.DS_Store
Thumbs.db
*.swp
*.swo
*.bak
*.tmp

# Python venvs (if you end up using ansible collections with pip)
.venv/
venv/

# Logs
*.log
