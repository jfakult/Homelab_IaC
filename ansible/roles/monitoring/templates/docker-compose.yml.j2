networks:
  monitoring:
    driver: bridge

services:
  prometheus:
    image: prom/prometheus:latest
    user: "65534:65534"
    container_name: prometheus
    restart: unless-stopped
    ports: ["9090:9090"]
    volumes:
      - /opt/monitoring/prometheus:/etc/prometheus
      - /opt/monitoring/prometheus-data:/prometheus
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time=30d
    networks: [monitoring]

  alertmanager:
    image: prom/alertmanager:latest
    container_name: alertmanager
    restart: unless-stopped
    ports: ["9093:9093"]
    volumes:
      - /opt/monitoring/alertmanager:/etc/alertmanager
    networks: [monitoring]

  # Local outbound-only SMTP relay for alertmanager - confirmed live
  # (2026-09-17) alertmanager has been crash-looping since 2026-08-07 with
  # "no global SMTP smarthost set" since nothing here ever sent mail.
  # Direct-to-MX delivery from a home IP is unreliable (residential/hosting
  # IP reputation, no SPF/DKIM/rDNS - very likely spam-filtered or blocked
  # outright), so this relays out through Gmail instead - alertmanager
  # itself only ever talks to this container on the local monitoring
  # network, unauthenticated; the Gmail app-password credential lives only
  # here, not in alertmanager's own config.
  postfix-relay:
    image: boky/postfix:latest
    container_name: postfix-relay
    restart: unless-stopped
    environment:
      RELAYHOST: "{{ smtp_relay_host }}"
      RELAYHOST_USERNAME: "{{ smtp_relay_username }}"
      RELAYHOST_PASSWORD: "{{ vault_smtp_relay_password }}"
      ALLOWED_SENDER_DOMAINS: "{{ smtp_relay_username.split('@')[1] }}"
    # LAN-only listener for non-compose senders (Unraid notifications)
    ports: ["192.168.1.211:25:25"]
    networks: [monitoring]

  grafana:
    image: grafana/grafana:latest
    container_name: grafana
    restart: unless-stopped
    ports: ["3000:3000"]
    environment:
      GF_SECURITY_ADMIN_PASSWORD: changeme
    volumes:
      - /opt/monitoring/grafana:/var/lib/grafana
    networks: [monitoring]

  loki:
    image: grafana/loki:2.9.8
    container_name: loki
    restart: unless-stopped
    ports: ["3100:3100"]
    command: ["-config.file=/etc/loki/loki-config.yml"]
    volumes:
      - /opt/monitoring/loki/loki-config.yml:/etc/loki/loki-config.yml:ro
      - /opt/monitoring/loki-data:/loki
    networks: [monitoring]

  blackbox:
    image: prom/blackbox-exporter:latest
    container_name: blackbox
    restart: unless-stopped
    ports: ["9115:9115"]
    command: ["--config.file=/etc/blackbox_exporter/blackbox.yml"]
    volumes:
      - /opt/monitoring/blackbox/blackbox.yml:/etc/blackbox_exporter/blackbox.yml:ro
    networks: [monitoring]

  # Internet speed history. Web UI on :3030, served publicly at
  # speedtest.{{ gateway_domain_root }} through the bastion (the `speedtest` entry in
  # `subdomains`). SQLite DB lives in /opt/monitoring/speedtest-tracker.
  # APP_KEY encrypts data stored in that DB: it must stay the same value
  # across redeploys (vault_speedtest_app_key).
  speedtest-tracker:
    image: lscr.io/linuxserver/speedtest-tracker:latest
    container_name: speedtest-tracker
    restart: unless-stopped
    ports: ["3030:80"]
    environment:
      PUID: "1000"
      PGID: "1000"
      TZ: "{{ tz }}"
      # Laravel needs the "base64:" prefix to decode the key; add it if the vault value is the bare key.
      APP_KEY: "{{ vault_speedtest_app_key if vault_speedtest_app_key.startswith('base64:') else 'base64:' ~ vault_speedtest_app_key }}"
      APP_URL: "https://speedtest.{{ gateway_domain_root }}"
      ASSET_URL: "https://speedtest.{{ gateway_domain_root }}"
      DB_CONNECTION: sqlite
      # cron expression (container TZ); see speedtest_schedule in all/main.yml
      SPEEDTEST_SCHEDULE: "{{ speedtest_schedule }}"
    volumes:
      - /opt/monitoring/speedtest-tracker:/config
    networks: [monitoring]
    logging:
      options:
        max-size: "10m"
        max-file: "3"

  # Latency graphs to a few internet targets. LAN + Tailscale only (no bastion
  # route): http://monitoring.yak-anoles.ts.net:3031/smokeping/ . Targets and
  # General are rendered from templates/monitoring/smokeping/config/.
  smokeping:
    image: lscr.io/linuxserver/smokeping:latest
    container_name: smokeping
    restart: unless-stopped
    ports: ["3031:80"]
    environment:
      PUID: "1000"
      PGID: "1000"
      TZ: "{{ tz }}"
    volumes:
      - /opt/monitoring/smokeping/config:/config
      - /opt/monitoring/smokeping/data:/data
    networks: [monitoring]
    logging:
      options:
        max-size: "10m"
        max-file: "3"
