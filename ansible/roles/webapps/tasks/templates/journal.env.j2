# Ansible-managed - do not edit by hand on the host, edit
# inventory/group_vars/{apps.yml,vault.yml} and re-run the playbook instead.
NEXTAUTH_SECRET={{ blinko_nextauth_secret }}
DATABASE_URL=postgresql://blinko:{{ blinko_postgres_password }}@192.168.1.203:5432/blinko

# /api suffix required here specifically - the ollama-ai-provider library
# blinko-journal uses defaults to "http://127.0.0.1:11434/api" and does NOT
# add /api itself, unlike Open WebUI's own Ollama client (which wants the
# bare host:port - see roles/compute's docker-compose-open-webui.yml.j2,
# same ollama_base_url var, no /api there). Confirmed live: omitting /api
# here 404s every chat request ("AI_APICallError: Not Found").
OLLAMA_BASE_URL={{ ollama_base_url }}/api
OLLAMA_CHAT_MODEL={{ ollama_chat_model }}
OLLAMA_EMBEDDING_MODEL={{ ollama_embedding_model }}
OLLAMA_VISION_MODEL={{ ollama_vision_model }}
# Not consumed yet - app-side code for this hasn't shipped. Wired ahead of
# time so it's live the moment it does. See apps.yml for why qwen3:1.7b.
OLLAMA_POST_PROCESSING_MODEL={{ ollama_post_processing_model }}

# Whisper confirmed healthy on "compute" (tested extensively - transcription,
# GPU placement, self-healing on Docker restarts) - safe to wire up now.
WHISPER_BASE_URL={{ whisper_base_url }}
WHISPER_MODEL={{ whisper_model }}
