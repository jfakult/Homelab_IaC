# Managed by roles/webapps (tasks/immich.yml); holds the DB password.
DB_URL=postgresql://{{ immich_db_user }}:{{ immich_db_password }}@{{ immich_db_host }}:{{ immich_pg_port }}/{{ immich_db_name }}
REDIS_HOSTNAME=valkey
IMMICH_MEDIA_LOCATION={{ immich_library_dir }}
IMMICH_TRUSTED_PROXIES={{ hostvars['bastion'].ansible_host }}
{% if immich_config_managed %}
IMMICH_CONFIG_FILE=/config/immich-config.json
{% endif %}
