[Unit]
Description=Nightly jobpipe run (/srv/www/jobs/jobpipe/run_all.sh)
RequiresMountsFor=/srv/www
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/www/jobs/jobpipe
ExecStart=/srv/www/jobs/jobpipe/run_all.sh
# Background job - stay out of the way of the running apps
Nice=10
# NFS is mounted "hard": if the NAS disappears mid-run, don't hang forever
TimeoutStartSec=6h
