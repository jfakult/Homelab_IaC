FROM {{ ollama_chat_model_base }}

# Hard ceiling on generation length, applied to whatever model is
# currently pinned via ollama_chat_model_base - not specific to one model.
# Added after a live incident (2026-09-14): a qwen3.5:9b generation ran
# 40,000+ tokens with no stop, repeatedly blowing past the context window
# via context-shift (silently discarding old tokens and continuing)
# instead of terminating - matches the earlier "CONFIRMED BROKEN"
# stress-test finding in apps.yml, this time reproducing live and pinning
# the GPU indefinitely until killed by hand. Ollama's default num_predict
# is unbounded (-1), so nothing caps worst-case generation time without
# this - kept as a standing safety net regardless of which model is
# pinned, since any model can in principle fail to emit a stop token.
# 6144 was sized for qwen3.5:9b (comfortably above the largest legitimate
# thinking trace seen, 3407 tokens, while bounding worst case to about a
# minute at its observed ~105-155 tok/s) - revisit if the pinned model's
# normal responses routinely run long and get truncated by this cap.
#
# 6144 -> 8192 (2026-09-16): gemma4:e4b (now pinned) was hitting this on
# ordinary multi-turn follow-ups, not runaway generation - separately, the
# real cause of the reported "stops/empty output" symptom turned out to be
# a missing NVIDIA CDI spec silently dropping GPU access (see
# gpu-containers-recreate.service.j2), not this cap. Raised anyway now that
# OLLAMA_CONTEXT_LENGTH is 16384 (docker-compose-ollama.yml.j2): kept at
# exactly half the context budget so a full-length generation always still
# leaves room for prompt + multi-turn history within the same window,
# rather than picking a number close to the ceiling that just moves the
# failure to whichever of the two runs out first.
PARAMETER num_predict 8192
