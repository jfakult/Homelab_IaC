# Self-hosted, OpenAI-API-compatible speech-to-text service for
# blinko-journal (Systran/speaches, https://github.com/speaches-ai/speaches).
# Adapted from blinko-journal's own docker-compose.whisper.yml.
#
# Deployed STANDALONE here (no docker-compose.network.yml overlay, no
# "blinko-internal" Docker-DNS network) because it runs on the "compute" VM
# (the only host with GPU passthrough) while blinko-website runs on a
# different VM ("webapps") entirely - the repo's docs assumed same-host
# co-location, which isn't possible on this real topology. blinko-website
# reaches this over the LAN at http://192.168.1.208:8000/v1 instead of a
# Docker DNS name - the published "ports: 8000:8000" below is load-bearing,
# not just for local debugging.

services:
  whisper:
    image: ghcr.io/speaches-ai/speaches:latest-cuda-12.6.3
    container_name: whisper
    restart: unless-stopped
    ports:
      - "8000:8000"
    volumes:
      - whisper-model-cache:/home/ubuntu/.cache/huggingface/hub
    environment:
      PRELOAD_MODELS: '["{{ whisper_model }}"]'
      WHISPER__INFERENCE_DEVICE: cuda
      WHISPER__COMPUTE_TYPE: float16
      UVICORN_HOST: 0.0.0.0
      UVICORN_PORT: 8000
      ENABLE_UI: "false"
      # Unload after 5 min idle so it isn't permanently resident alongside
      # Ollama - fits this journal's bursty usage pattern (see
      # docs/workstreams/02-whisper-service.md in blinko-journal).
      #
      # Was named STT_MODEL_TTL - confirmed live (2026-09-14) that key is
      # silently ignored: speaches' actual pydantic-settings config field
      # is whisper.ttl, exposed via the nested WHISPER__ prefix (same
      # pattern as WHISPER__INFERENCE_DEVICE/WHISPER__COMPUTE_TYPE below),
      # not a top-level STT_MODEL_TTL. The "300" we were seeing was the
      # library's own default coinciding with our intended value, not this
      # var actually doing anything. Transcription requests auto-reload an
      # idle-evicted-but-still-cached model on demand (server/routers/
      # stt.py calls model_manager.load_model() every request), so this
      # TTL is a VRAM-saving knob, not a correctness one - low stakes
      # either way, but worth being real.
      WHISPER__TTL: "300"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000/health"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
    logging:
      options:
        max-size: "10m"
        max-file: "3"
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu]
    # LAN/Tailscale-only egress (roles/compute/tasks/firewall.yml). CAVEAT:
    # this container pulls model weights from Hugging Face on first use of
    # a given model (see the top-of-file comment) - already cached for
    # {{ whisper_model }} as of this deploy, so this is safe now, but
    # switching WHISPER_MODEL to something not already in the
    # whisper-model-cache volume later will need a temporary WAN allowance
    # (or a manual pull before locking egress back down) - it will NOT
    # silently degrade, it'll just fail to start.
    networks:
      - compute-lan

networks:
  compute-lan:
    external: true

volumes:
  whisper-model-cache:
