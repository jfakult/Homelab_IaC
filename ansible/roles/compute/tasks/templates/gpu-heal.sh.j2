#!/bin/bash
{% raw %}
# AUTO-GENERATED by roles/compute/tasks/main.yaml. Edit that role, not this
# file directly on the host - a re-run overwrites it.
#
# Finds every container on this host that uses the NVIDIA GPU and heals them
# together, so a new GPU service (e.g. Immich's ML container) is covered with
# no change here. A container counts as a GPU container when its HostConfig
# has an NVIDIA device request (compose `deploy.resources.reservations.devices:
# driver: nvidia`) or uses the nvidia runtime.
#
#   gpu-heal.sh list              name|service|compose-dir|compose-file per GPU container
#   gpu-heal.sh recreate          force-recreate each GPU service (compose, --no-deps)
#   gpu-heal.sh check [SINCE]     report GPU containers that have lost the GPU; exit 1 if any.
#                                 SINCE (e.g. 2026-10-18T10:00:00) limits the log scan.
#
# WHY RECREATE (not restart): a container's GPU cgroup access is bound to the
# dockerd/containerd instance it started under, and a missing NVIDIA CDI spec
# makes Docker start containers with no GPU and no error. Only a recreate
# re-acquires access. See gpu-containers-recreate.service for the triggers.
set -uo pipefail

# Log lines that mean "this process lost the GPU / fell back to CPU".
SIGNATURES='failed to initialize CUDA|Failed to initialize NVML|no CUDA-capable device'

list() {
  local ids
  ids=$(docker ps -aq) || return 1
  [ -n "$ids" ] || return 0
  # shellcheck disable=SC2086
  docker inspect $ids --format '{{.Name}}|{{.HostConfig.Runtime}}|{{json .HostConfig.DeviceRequests}}|{{index .Config.Labels "com.docker.compose.service"}}|{{index .Config.Labels "com.docker.compose.project.working_dir"}}|{{index .Config.Labels "com.docker.compose.project.config_files"}}' |
    awk -F'|' '$2 == "nvidia" || $3 ~ /"Driver":"nvidia"/ { sub(/^\//, "", $1); split($6, f, ","); print $1 "|" $4 "|" $5 "|" f[1] }'
}

recreate() {
  local rc=0 name svc wd file
  while IFS='|' read -r name svc wd file; do
    if [ -z "$svc" ] || [ -z "$wd" ] || [ -z "$file" ]; then
      echo "gpu-heal: $name is a GPU container but not managed by compose; not recreated" >&2
      rc=1; continue
    fi
    echo "gpu-heal: recreating $name ($svc in $wd)"
    docker compose --project-directory "$wd" -f "$file" up -d --force-recreate --no-deps "$svc" || rc=1
  done < <(list)
  return $rc
}

check() {
  local since=${1:-} bad=0 name svc wd file out rc
  while IFS='|' read -r name svc wd file; do
    [ "$(docker inspect -f '{{.State.Running}}' "$name" 2>/dev/null)" = true ] || continue
    # Active probe: nvidia-smi inside the container. 126/127 = tool not in the image: skip the probe.
    out=$(timeout 20 docker exec "$name" nvidia-smi -L 2>&1); rc=$?
    if [ "$rc" -ne 0 ] && [ "$rc" -ne 126 ] && [ "$rc" -ne 127 ]; then
      echo "$name: nvidia-smi failed ($(echo "$out" | head -1))"; bad=1; continue
    fi
    # Passive probe: some runtimes (Ollama) silently fall back to CPU and log it.
    if docker logs ${since:+--since "$since"} "$name" 2>&1 | grep -qE "$SIGNATURES"; then
      echo "$name: logs show it lost the GPU"; bad=1
    fi
  done < <(list)
  return $bad
}

case "${1:-}" in
  list) list ;;
  recreate) recreate ;;
  check) shift; check "$@" ;;
  *) echo "usage: $0 list|recreate|check [SINCE]" >&2; exit 2 ;;
esac
{% endraw %}
