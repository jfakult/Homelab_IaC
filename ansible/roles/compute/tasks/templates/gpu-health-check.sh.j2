#!/bin/bash
# AUTO-GENERATED by roles/compute/tasks/main.yaml. Edit that role, not this
# file directly on the host - a re-run overwrites it.
#
# WHY THIS EXISTS: gpu-containers-recreate.service (PartOf docker.service
# containerd.service) heals GPU access whenever either daemon restarts, and
# now also regenerates the NVIDIA CDI spec each time (see that unit's own
# comment for the 2026-09-16 incident this closes). But neither of those
# triggers fires if GPU access is lost WITHOUT docker/containerd
# restarting - e.g. the CDI spec going stale after a driver library changes
# underneath a still-running container, or any other silent CUDA init
# failure. Ollama's own healthcheck (`ollama list`) only checks the API is
# responding, which succeeds identically whether inference is running on
# GPU or has silently fallen back to CPU - so nothing else would ever
# notice this class of failure. This polls for the exact failure signature
# seen live and self-heals by reusing the existing recreate unit, escalating
# to a VM reboot only if that doesn't fix it after repeated tries.
set -euo pipefail

STATE_DIR=/run/gpu-health-check
mkdir -p "$STATE_DIR"
SINCE_FILE="$STATE_DIR/since"
FAILS_FILE="$STATE_DIR/fails"

SINCE=$(cat "$SINCE_FILE" 2>/dev/null || date -u -d '{{ gpu_health_check_interval_minutes }} minutes ago' +%Y-%m-%dT%H:%M:%S)
date -u +%Y-%m-%dT%H:%M:%S > "$SINCE_FILE"

if ! docker logs --since "$SINCE" ollama 2>&1 | grep -q 'failed to initialize CUDA'; then
  echo 0 > "$FAILS_FILE"
  exit 0
fi

FAILS=$(( $(cat "$FAILS_FILE" 2>/dev/null || echo 0) + 1 ))
echo "$FAILS" > "$FAILS_FILE"
logger -t gpu-health-check "ollama lost GPU access (CUDA init failure seen in logs, consecutive failure #$FAILS) - recreating GPU containers"
systemctl restart gpu-containers-recreate.service

if [ "$FAILS" -ge {{ gpu_health_check_max_fails }} ]; then
  logger -t gpu-health-check "GPU access still broken after $FAILS consecutive recreate attempts - rebooting VM as last resort"
  echo 0 > "$FAILS_FILE"
  systemctl reboot
fi
