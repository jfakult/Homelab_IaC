#!/bin/bash
# AUTO-GENERATED by roles/compute/tasks/main.yaml - re-running the compute
# play overwrites this file. Edit inventory/group_vars/apps.yml's
# `compute_lan_subnet` instead of hand-editing this script.
#
# Temporarily lifts the compute-lan WAN block (roles/compute/tasks/firewall.yml)
# so `ollama pull <model>` / a new WHISPER_MODEL can actually reach the
# internet the first time a given model is fetched. Deliberately NOT
# persisted when opened - only `close` (and a normal ansible re-run) ever
# gets saved via netfilter-persistent, so a reboot (or forgetting to close
# it) fails back to locked-down, never leaves WAN open by accident.
set -euo pipefail

SUBNET="{{ compute_lan_subnet }}"
COMMENT="compute-lan-wan-toggle"

if [ "$EUID" -ne 0 ]; then
  echo "Run as root (sudo $0 $*)." >&2
  exit 1
fi

is_open() {
  iptables -C DOCKER-USER -s "$SUBNET" -j ACCEPT -m comment --comment "$COMMENT" 2>/dev/null
}

case "${1:-}" in
  open)
    if is_open; then
      echo "Already open."
    else
      iptables -I DOCKER-USER -s "$SUBNET" -j ACCEPT -m comment --comment "$COMMENT"
      echo "WAN egress OPENED for compute-lan ($SUBNET)."
      echo "Pull whatever model you need, then run: $0 close"
    fi
    ;;
  close)
    while is_open; do
      iptables -D DOCKER-USER -s "$SUBNET" -j ACCEPT -m comment --comment "$COMMENT"
    done
    netfilter-persistent save >/dev/null 2>&1 || true
    echo "WAN egress CLOSED for compute-lan ($SUBNET) - back to LAN/Tailscale-only."
    ;;
  status)
    if is_open; then
      echo "OPEN (WAN allowed) - remember to close this when done."
    else
      echo "CLOSED (LAN/Tailscale-only)"
    fi
    ;;
  *)
    echo "Usage: $0 {open|close|status}"
    echo "  open   - temporarily allow compute-lan (Ollama/Whisper/Open WebUI) out to WAN, e.g. to pull a new model"
    echo "  close  - restore LAN/Tailscale-only (also persists via netfilter-persistent)"
    echo "  status - show current state"
    exit 1
    ;;
esac
