# AUTO-GENERATED by roles/compute/tasks/main.yaml. Edit that role, not this
# file directly on the host - a re-run overwrites it.
#
# WHY THIS EXISTS: Docker+NVIDIA has a well-known failure mode where a
# container's GPU cgroup device access gets bound to the specific dockerd
# (or containerd) process instance it was started under - if either daemon
# restarts for ANY reason (host reboot, `apt upgrade` of docker packages,
# unattended-upgrades, manual intervention) while ollama/whisper are already
# running, `docker restart` alone brings the container back but leaves it
# unable to see the GPU (`nvidia-smi` inside the container fails with
# "Failed to initialize NVML: Unknown Error") - only a full recreate
# re-acquires correct device access. This unit makes that recreation
# automatic instead of something that has to be caught and fixed by hand
# after the fact.
#
# containerd.service is included alongside docker.service on purpose, not
# redundantly - confirmed live (2026-09-11) that needrestart auto-restarts
# containerd.service whenever a routine unattended-upgrades security patch
# touches a shared library it links (libc6 that day), breaking GPU access
# for already-running containers WITHOUT docker.service itself restarting
# (needrestart's own default config already excludes anything matching
# `^docker`, but containerd isn't covered by that pattern - see the
# needrestart override task in main.yaml for the other half of this fix).
# PartOf=docker.service alone missed this entirely since docker.service's
# own uptime never changed.
#
# ExecStartPre (2026-09-16): a full recreate alone turned out NOT to be
# sufficient - confirmed live that /etc/cdi/nvidia.yaml had never existed on
# this host. Modern nvidia-container-toolkit (config.toml has
# nvidia-container-runtime.mode = "auto") resolves compose's
# `deploy.resources.reservations.devices driver: nvidia` GPU request via CDI
# FIRST, and when the CDI spec is missing, dockerd only logs a warning
# ("CDI device injection failed: unresolvable CDI devices nvidia.com/gpu=0")
# and starts the container anyway WITHOUT real GPU device access - no error,
# no unhealthy status, `ollama` just silently falls back to CPU inference
# (confirmed: ggml_cuda_init: failed to initialize CUDA: no CUDA-capable
# device is detected, size_vram=0 in /api/ps). This recreate unit was
# firing correctly on every docker/containerd restart but recreating into
# the same broken CDI-less state every time. Regenerating the spec here
# closes that gap at the same trigger this unit already responds to
# (reboot, apt upgrade, containerd bounce) - the CDI spec embeds
# driver-version-specific .so paths (e.g. libnvidia-ml.so.580.173.02), so it
# also needs refreshing after a deliberate driver upgrade, which this
# covers for free since that always involves a reboot.
[Unit]
Description=Recreate every GPU container (found by gpu-heal.sh) after Docker or containerd starts
After=docker.service containerd.service
Requires=docker.service
# PartOf (not just After/Requires) is what makes this re-run every time
# docker.service OR containerd.service itself restarts (host reboot, `apt
# upgrade`, a manual `systemctl restart docker`, ansible's own "Restart
# docker" handler firing after nvidia-ctk changes, needrestart bouncing
# containerd after a library upgrade) - not just once at boot.
PartOf=docker.service containerd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml
# gpu-heal.sh finds the GPU containers itself (NVIDIA device request / nvidia runtime),
# so a new GPU service is covered without editing this unit.
ExecStart=/usr/local/sbin/gpu-heal.sh recreate

[Install]
WantedBy=multi-user.target
