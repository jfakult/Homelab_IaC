services:
  nginx:
    image: docker.io/library/nginx:1.27-alpine
    container_name: rp-nginx
    restart: unless-stopped
    ports: [ "80:80", "443:443" ]
    security_opt:
      - apparmor:unconfined
    volumes:
      - /srv/www:/usr/share/nginx/html:ro
      - /srv/nas:/usr/share/nginx/nas:ro
      - /srv/share:/usr/share/nginx/share:ro
      - /etc/nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - /etc/nginx/conf.d:/etc/nginx/conf.d:ro
      - /etc/nginx/snippets:/etc/nginx/snippets:ro
      - /etc/nginx/tls:/etc/nginx/tls:ro
      - {{ ssl_dir }}:{{ ssl_dir }}:ro
      - /etc/hosts:/etc/hosts:ro
      - /etc/resolv.conf:/etc/resolv.conf:ro
      - /var/www/letsencrypt:/usr/share/nginx/letsencrypt:ro
      - /etc/letsencrypt:/etc/letsencrypt:ro
    # nginx -t alone can't see the NAS. Also require the NAS-backed docroot
    # and nas dir to list non-empty (catches stale handles and a container
    # started against an empty mountpoint). docker-autoheal restarts it.
    healthcheck:
      test: ["CMD-SHELL","nginx -t && [ -n \"$$(ls /usr/share/nginx/html | head -1)\" ] && [ -n \"$$(ls /usr/share/nginx/nas | head -1)\" ]"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 20s
    labels:
      autoheal: "true"
      autoheal.log_pattern: "Stale file handle"

  nginx_exporter:
    image: nginx/nginx-prometheus-exporter:latest
    container_name: nginx_exporter
    restart: unless-stopped
    command:
      - -nginx.scrape-uri=http://127.0.0.1:8081/nginx_status
    ports:
      - "9113:9113"

  cadvisor:
    image: gcr.io/cadvisor/cadvisor:latest
    container_name: cadvisor
    restart: unless-stopped
    ports:
      - "8080:8080"
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run
      - /sys:/sys:ro
      - /var/lib/docker:/var/lib/docker:ro
    # If metrics look sparse on cgroup v2, uncomment:
    # privileged: true

  node_exporter:
    image: quay.io/prometheus/node-exporter:latest
    container_name: node_exporter
    restart: unless-stopped
    network_mode: host           # exposes directly on port 9100
    pid: host                    # so it can see host PIDs
    volumes:
      - /:/host:ro,rslave
    command:
      - --path.rootfs=/host
    ports:
      - "9100:9100"              # optional; not needed with host network