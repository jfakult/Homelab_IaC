worker_processes auto;
pid /run/nginx.pid;

events {
  worker_connections 1024;
}

http {
  #include       /etc/nginx/mime.types;
  default_type  application/octet-stream;
  sendfile on;
  keepalive_timeout 65;

  index index.html index.htm;

  map $http_upgrade $connection_upgrade { default upgrade; '' close; }

  # Reusable proxy headers
  include /etc/nginx/conf.d/proxy_common.conf;

  # Metrics endpoint for Prometheus scraping
  include /etc/nginx/conf.d/metrics.conf;

  # Per-subdomain vhosts (sso.fakult.net, chat.fakult.net, and whatever else
  # gets added to the `subdomains` list in inventory/group_vars/all/main.yml)
  # - auto-generated by roles/bastion/tasks/render_subdomains.yml. Add a new
  # subdomain there; nothing in this file needs to change. See docs/subdomains.md.
  include /etc/nginx/conf.d/subdomains/*.conf;

  server {
    listen 80;
    listen [::]:80;
    server_name {{ domain_name }};

    location ^~ /.well-known/acme-challenge/ {
        default_type "text/plain";
        root /usr/share/nginx/letsencrypt;
    }

    # Special exceptions served in plaintext
    location = /nossl {
      default_type text/plain;
      return 200 "This is plain HTTP!\n";
    }
    # Special exceptions served in plaintext
    location /neverssl {
      default_type text/plain;
      return 200 "This is plain HTTP!\n";
    }
    location /http {
      default_type text/plain;
      return 200 "This is plain HTTP!\n";
    }

    # Explicitely serve tron resources over HTTP and allow indexing
    location /tron {
      root /usr/share/nginx/html;
      autoindex on;
    }

    # Everything else → HTTPS
    location / {
      return 301 https://$host$request_uri;
    }
  }

  server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ domain_name }};

    # default: private only
    allow 192.168.1.0/24;
    allow 100.64.0.0/10;
    deny all;

    ssl_certificate     /etc/letsencrypt/live/{{ domain_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain_name }}/privkey.pem;


    include /etc/nginx/conf.d/ssl_params.conf;

    # If someone tries to force http endpoint over HTTPS, send them back to HTTP
    location /nossl { return 301 http://$host$request_uri; }
    location /neverssl { return 301 http://$host$request_uri; }
    location /http  { return 301 http://$host$request_uri; }
    # location /tron { return 301 http://$host$request_uri; }

    # Static files
    include /etc/nginx/snippets/static.conf;

    # Proxied services
    include /etc/nginx/snippets/dns.conf;
    include /etc/nginx/snippets/ai.conf;
    include /etc/nginx/snippets/monitoring.conf;
    include /etc/nginx/snippets/jellyfin.conf;
    include /etc/nginx/snippets/kiwix.conf;     # port 3090
    include /etc/nginx/snippets/journal.conf;     # port 1111 (blinko)
    include /etc/nginx/snippets/nodeJS_servers.conf;     # port 3090

    # fakult.net/<name> -> https://<name>.fakult.net (auto-generated from
    # the `subdomains` list - see render_subdomains.yml)
    include /etc/nginx/snippets/subdomain-redirects.conf;

    location /share {
		  alias /usr/share/nginx/share;   # the Public NAS share (/srv/share, bound by the compose file)
		  autoindex on;
		}

    # /srv/www/_webapps is the NAS backup mirror of the webapps VM's app source
    # (roles/webapps, webapps-nas-sync) - it sits inside the web root but must
    # never be served. ^~ so no regex location can take it over.
    location ^~ /_webapps {
        return 404;
    }

    # Alias: /juggling[/...] -> /juggle/[...] (static site in /srv/www/juggle)
    # (rewrite, not `return ... $1`: $1 is URL-decoded, rewrite re-encodes)
    location ~ ^/juggling(?:/|$) {
        allow all;
        rewrite ^/juggling/?(.*)$ /juggle/$1 permanent;
    }

    # Catch-all fallback
    location / {
        allow all;
        root /usr/share/nginx/html;
        try_files $uri $uri/ =404;    # only existing files; otherwise 404
        autoindex off;
    }
  }
}
