services:
  postgres:
    image: docker.io/library/postgres:{{ pg_version }}
    container_name: pg-main
    restart: unless-stopped
    environment:
      POSTGRES_USER: "{{ pg_admin_user }}"
      POSTGRES_PASSWORD: "{{ pg_admin_password }}"
      POSTGRES_DB: "{{ pg_admin_db }}"
    volumes:
      - {{ pg_db_dir }}:/var/lib/postgresql/data
      - {{ pg_backups_dir }}:/backups
      - {{ pg_dir }}/conf:/etc/postgresql/conf
      - /etc/hosts:/etc/hosts:ro
      - /etc/resolv.conf:/etc/resolv.conf:ro
    command: >
      -c config_file=/etc/postgresql/conf/postgresql.conf
    ports:
      - "5432:5432"
    healthcheck:
      test: ["CMD-SHELL","pg_isready -U {{ pg_admin_user }} -d {{ pg_admin_db }}"]
      interval: 10s
      timeout: 5s
      retries: 6
