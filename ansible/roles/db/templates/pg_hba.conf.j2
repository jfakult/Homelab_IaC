# per-database access (pg_databases in group_vars/infra.yml)
{% for d in pg_databases %}
{% for cidr in d.cidrs %}
host    {{ d.name }}   {{ d.owner }}   {{ cidr }}   md5
{% endfor %}
{% endfor %}

# local
local   all   {{ pg_admin_user }}   md5
local   all   all                     peer
host    all   all   127.0.0.1/32      md5
host    all   all   ::1/128           md5
host    all   all   172.17.0.1/32     md5   # docker
host    all   all   172.18.0.1/32     md5   # docker
