# pg-immich: Immich's own Postgres (VectorChord). Separate from pg-main because
# Immich needs the vchord/pgvecto.rs extensions that the stock image lacks.
# Managed by roles/db (tasks/immich_postgres.yml); do not hand-edit.
services:
  postgres:
    image: {{ immich_pg_image }}
    container_name: pg-immich
    restart: unless-stopped
    environment:
      POSTGRES_USER: "{{ immich_db_user }}"
      POSTGRES_PASSWORD: "{{ immich_db_password }}"
      POSTGRES_DB: "{{ immich_db_name }}"
      POSTGRES_INITDB_ARGS: "--data-checksums"
    # Data directory on this VM's disk, never the NAS (network shares are not
    # supported for the database).
    volumes:
      - {{ immich_pg_data_dir }}:/var/lib/postgresql/data
      - /etc/hosts:/etc/hosts:ro
    shm_size: 128mb
    ports:
      - "{{ immich_pg_port }}:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ immich_db_user }} -d {{ immich_db_name }}"]
      interval: 10s
      timeout: 5s
      retries: 6
